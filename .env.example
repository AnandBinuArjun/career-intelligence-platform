APP_ENV=development
APP_NAME=Career Intelligence Platform
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Generate separate values with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
RATE_LIMIT_ENABLED=true

DATABASE_URL=postgresql+psycopg://career_app:change-me-local-only@localhost:5432/career_intelligence
POSTGRES_DB=career_intelligence
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=local-admin-only
APP_DB_PASSWORD=change-me-local-only
REDIS_URL=redis://localhost:6379/0

STORAGE_BACKEND=s3
LOCAL_STORAGE_DIR=.private_storage
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cv-private
S3_ACCESS_KEY=minio-dev
S3_SECRET_KEY=change-me-local-only
S3_USE_SSL=false
PRESIGNED_UPLOAD_TTL_SECONDS=300
MAX_UPLOAD_MB=10
MAX_DOCX_UNCOMPRESSED_MB=50
ALLOWED_UPLOAD_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain

AI_ROUTING_MODE=local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
EXTERNAL_AI_ENABLED=false
EXTERNAL_AI_BASE_URL=
EXTERNAL_AI_API_KEY=
EXTERNAL_AI_MODEL=
EXTERNAL_AI_REQUIRES_CONSENT=true
